NYANBIN_REDIS_PREFIX=nyanbin:test:
NYANBIN_MAX_ENVELOPE_BYTES=10485760
NYANBIN_MAX_EXPIRES_IN=604800
NYANBIN_DEFAULT_EXPIRES_IN=86400
NYANBIN_MAX_READS=100
NYANBIN_DEFAULT_MAX_READS=1
NYANBIN_RESERVATION_TTL_SECONDS=120
NYANBIN_REDIS_TIMEOUT_MS=2000
NYANBIN_RATE_LIMIT_REQUESTS=10000
NYANBIN_RATE_LIMIT_WINDOW_SECONDS=60
NYANBIN_RATE_LIMIT_GLOBAL_REQUESTS=100000
NYANBIN_RATE_LIMIT_SHORT_CREATE_REQUESTS=10000
NYANBIN_RATE_LIMIT_SHORT_RESOLVE_REQUESTS=10000
NYANBIN_RATE_LIMIT_IPV6_PREFIX_BITS=64
NYANBIN_TRUSTED_PROXY_CIDRS=
# Storage budget disabled on the shared test app so the existing suite never trips the pressure guard;
# the dedicated 'pressure' compose service (127.0.0.1:3002) exercises budget semantics instead.
NYANBIN_STORAGE_BUDGET_BYTES=0
# Per-client hourly byte quota disabled on the shared test app; the 'ops' compose service
# (127.0.0.1:3001) exercises the byte bucket with a small quota instead.
NYANBIN_BUCKET_BYTES_PER_HOUR=0
# CORS stays off on the shared test app (empty = disabled); cors specs assert the absence of
# access-control headers here and the allowlist behaviour on the 'ops' service.
NYANBIN_CORS_ORIGINS=
# Generous per-operation client limits so the browser/CLI suite never rate-limits itself;
# the 'ops' compose service overrides these with tight values to exercise 429 semantics.
NYANBIN_RATE_LIMIT_INFO_REQUESTS=10000
NYANBIN_RATE_LIMIT_REVEAL_REQUESTS=10000
NYANBIN_RATE_LIMIT_DELETE_REQUESTS=10000
