{
  "name": "nyanbin-workspace",
  "private": true,
  "scripts": {
    "dev:valkey": "docker compose -f docker-compose.dev.yaml up valkey",
    "dev:packages": "pnpm --parallel --recursive run dev",
    "dev": "run-p dev:valkey dev:packages",
    "docker:up": "docker compose -f docker-compose.dev.yaml up --build",
    "docker:down": "docker compose -f docker-compose.dev.yaml down --remove-orphans",
    "docker:build": "docker compose -f docker-compose.dev.yaml build",
    "build": "pnpm --recursive run build",
    "licenses:generate": "node scripts/generate-dependency-licenses.mjs",
    "openapi:generate": "node scripts/openapi-json.mjs",
    "check": "pnpm --recursive --if-present run check",
    "test": "playwright test",
    "test:local": "playwright test --project=chromium",
    "test:prepare": "run-p build docker:build test:install-browsers",
    "test:install-browsers": "playwright install",
    "ci": "run-s build check test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "ajv": "^8.20.0",
    "npm-run-all": "^4.1.5",
    "shelljs": "^0.8.5",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.5.0"
}
